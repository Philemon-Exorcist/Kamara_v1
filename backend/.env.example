GOOGLE_GENAI_USE_VERTEXAI=FALSE # true if in production
GEMINI_API_KEY=your_gemini_api_key_here

SUPABASE_SERVICE_KEY=your_supabase_service_key_here


# Replace this with your project-specific Supabase URL from the dashboard.
# Example: SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_URL=your_supabase_url_here


# Paystack Secret Key
ENABLE_KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_SECONDS=600


PAYSTACK_SECRET_KEY=The_Paystack_API_Secret

# Paystack Plan Mapping
PAYSTACK_PLAN_STARTER=The_Starter_Plan_Code
PAYSTACK_PLAN_PRO=The_Pro_Plan_Code
PAYSTACK_PLAN_GROUP=The_Study_Group_plan_Code

# Frontend base URL used for auth email redirects
FRONTEND_APP_URL=http://localhost:5173
